  "methodRules": [
    {
      "id": "sign-method-period_resolution",
      "systemId": "guaan-yi-sign-64",
      "step": 1,
      "code": "period_resolution",
      "title": "识别当前时段",
      "rule": {
        "timezone": "user_profile_or_Asia/Shanghai",
        "periods": [
          "morning",
          "noon",
          "afternoon",
          "evening"
        ]
      },
      "explanation": "依据用户时区识别早签、午签、下午签或晚签。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-date_anchor",
      "systemId": "guaan-yi-sign-64",
      "step": 2,
      "code": "date_anchor",
      "title": "晚签日期归属",
      "rule": {
        "beforeHour": 6,
        "belongsToPreviousDate": true
      },
      "explanation": "凌晨零点至五点五十九分仍属于前一日的晚签。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-one_draw_per_period",
      "systemId": "guaan-yi-sign-64",
      "step": 3,
      "code": "one_draw_per_period",
      "title": "每时段一支新签",
      "rule": {
        "uniqueBy": [
          "userId",
          "signDate",
          "period"
        ],
        "repeatReturnsExisting": true
      },
      "explanation": "同一用户在同一签日与时段再次进入时展示原签，不重新抽取。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-uniform_draw",
      "systemId": "guaan-yi-sign-64",
      "step": 4,
      "code": "uniform_draw",
      "title": "六十四签等概率",
      "rule": {
        "candidateCount": 64,
        "weightedByPeriod": false
      },
      "explanation": "时段只影响签象落点，不暗中改变各签抽中概率。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-secure_random",
      "systemId": "guaan-yi-sign-64",
      "step": 5,
      "code": "secure_random",
      "title": "服务端安全随机",
      "rule": {
        "algorithm": "crypto.randomInt",
        "clientRandomForbidden": true
      },
      "explanation": "抽取必须在服务端完成，不使用 Math.random 或客户端传入的签号。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-immutable_draw",
      "systemId": "guaan-yi-sign-64",
      "step": 6,
      "code": "immutable_draw",
      "title": "解签不改变原签",
      "rule": {
        "interpretationUsesStoredSign": true,
        "redrawDuringConversation": false
      },
      "explanation": "点击解签、补充问题和继续对话始终围绕原签。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-interpretation_layers",
      "systemId": "guaan-yi-sign-64",
      "step": 7,
      "code": "interpretation_layers",
      "title": "分层组合解签",
      "rule": {
        "order": [
          "canonical_hexagram",
          "sign_entry",
          "period_profile",
          "question_domain",
          "user_context",
          "action"
        ]
      },
      "explanation": "经典依据、时段落点和用户处境分层组合，并保留来源。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-no_fatalism",
      "systemId": "guaan-yi-sign-64",
      "step": 8,
      "code": "no_fatalism",
      "title": "禁止宿命化输出",
      "rule": {
        "forbidden": [
          "必成",
          "必败",
          "命中注定",
          "灾祸保证",
          "第三方内心断言"
        ]
      },
      "explanation": "签象只提供观察角度、成立条件和可执行方向。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    },
    {
      "id": "sign-method-review_instead_of_redraw",
      "systemId": "guaan-yi-sign-64",
      "step": 9,
      "code": "review_instead_of_redraw",
      "title": "优先复盘而非重抽",
      "rule": {
        "sameQuestionUsesFollowUp": true,
        "materialChangeAllowsNewSession": true
      },
      "explanation": "同一问题优先回看行动与新事实，现实条件明显变化后再开启新会话。",
      "version": "2026-07-23.guaan-yi-sign-v1",
      "isActive": true
    }
  ]
}
