# ============================================================
# AI 国学生活顾问 — 环境变量示例
# 复制为 .env 后填入真实值。.env 不要提交到 git。
# ============================================================

# ---------- 应用 ----------
NEXT_PUBLIC_APP_NAME=AI 国学生活顾问
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---------- 数据库 ----------
# 准生产 Demo 使用 Neon Postgres。Vercel Marketplace Neon 会自动提供真实 DATABASE_URL。
# 本地如果继续用 SQLite，需要使用旧 schema 或单独本地分支。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# ---------- AI Provider ----------
# 可选值：mock | anthropic | openai
# mock 模式不调用任何外部 API，使用内置示例报告，适合本地开发
AI_PROVIDER=mock

# Anthropic Claude 配置。AI_PROVIDER=anthropic 时再填写 ANTHROPIC_API_KEY。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.4

# OpenAI 配置暂不启用。以后 AI_PROVIDER=openai 时再填写 OPENAI_API_KEY。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 默认模型，按用户要求使用 gpt-5.5
OPENAI_MODEL=gpt-5.5
# fallback 模型，主模型不可用时降级
OPENAI_FALLBACK_MODEL=gpt-5.5
# reasoning effort：免费报告用 high，付费深度报告用 xhigh
OPENAI_REASONING_EFFORT_BASIC=high
OPENAI_REASONING_EFFORT_DEEP=xhigh
OPENAI_REASONING_EFFORT=high
# 报告类温度建议较低
OPENAI_TEMPERATURE=0.4
# 单次请求超时（毫秒）
OPENAI_TIMEOUT_MS=60000

# ---------- 支付（MVP mock，勿在生产留空） ----------
# 可选值：mock | wechat | alipay
PAYMENT_PROVIDER=mock
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---------- 会话 ----------
# 用于签名匿名用户 cookie，请改为强随机字符串
SESSION_SECRET=

# ---------- 日志 ----------
# 是否将 AI 请求/响应原文写入 model_logs（生产建议关闭，仅留 token usage）
LOG_AI_RAW_PAYLOAD=false
